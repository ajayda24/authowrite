# ---------------------------------------------------------------------------
# Authowrite configuration. Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

# Public URL of this instance (used for links in emails and auth callbacks).
APP_URL=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgres://authowrite:authowrite@localhost:5432/authowrite

# Secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# --- File storage ----------------------------------------------------------
# "local" stores uploads on disk; "s3" uses any S3-compatible service
# (AWS S3, MinIO, Cloudflare R2, Backblaze B2, Garage, ...).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=authowrite
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Email -----------------------------------------------------------------
# Without SMTP_URL, emails (e.g. password reset links) are printed to the
# server log instead of being sent.
# SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM="Authowrite <no-reply@example.com>"

# --- Optional sign-in providers -------------------------------------------
# Providers are enabled automatically when both values are set.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
